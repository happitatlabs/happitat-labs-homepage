{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happitat-mel-guide",
  "main": "mel/worker.ts",
  "compatibility_date": "2026-06-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "MEL_AI_ENABLED": "false", "MEL_GLOBAL_DAILY_LIMIT": "30" },
  "durable_objects": { "bindings": [{ "name": "MEL_QUOTA", "class_name": "MelQuota" }] },
  "migrations": [{ "tag": "mel-v1", "new_sqlite_classes": ["MelQuota"] }]
}
